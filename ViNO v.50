        ];

        // --- GEMINI API HELPER FUNCTIONS ---
        async function fetchWithRetry(url, options, maxRetries = 3) {
            let delay = 1000;
            for (let i = 0; i < maxRetries; i++) {
                try {
                    const res = await fetch(url, options);
                    if (res.ok) return res;
                    if (res.status === 429 || res.status >= 500) {
                        await new Promise(r => setTimeout(r, delay));
                        delay *= 2;
                        continue;
                    }
                    return res;
                } catch (e) {
                    if (i === maxRetries - 1) throw e;
                    await new Promise(r => setTimeout(r, delay));
                    delay *= 2;
                }
            }
        }

        async function callGeminiText({ apiKey, prompt, systemInstruction = "", chatHistory = [], responseSchema = null }) {
            const keyToUse = apiKey || "YOUR_API_KEY_HERE"; 
            const url = `https://generativelanguage.googleapis.com/v1beta/models/${GEMINI_TEXT_MODEL}:generateContent?key=${keyToUse}`;

            let contents = [];
            if (chatHistory && chatHistory.length > 0) {
                contents = [...chatHistory];
            }
            contents.push({ role: "user", parts: [{ text: prompt }] });

            const payload = { contents };
            if (systemInstruction) payload.systemInstruction = { parts: [{ text: systemInstruction }] };
            if (responseSchema) payload.generationConfig = { responseMimeType: "application/json", responseSchema: responseSchema };

            const response = await fetchWithRetry(url, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload)
            });

            if (!response.ok) {
                const errText = await response.text();
                throw new Error(`Gemini Text API error: ${response.status} - ${errText}`);
            }

            const data = await response.json();
            return data?.candidates?.[0]?.content?.parts?.[0]?.text || "";
        }

        async function callGeminiImage({ apiKey, prompt, aspectRatio = "3:4" }) {
            const keyToUse = apiKey || "YOUR_API_KEY_HERE";
            const url = `https://generativelanguage.googleapis.com/v1beta/models/${GEMINI_IMAGE_MODEL}:generateContent?key=${keyToUse}`;

            const payload = {
                contents: [{ role: "user", parts: [{ text: prompt }] }],
                generationConfig: { responseModalities: ["IMAGE"], imageConfig: { aspectRatio: aspectRatio } }
            };

            const response = await fetchWithRetry(url, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload)
            });

            if (!response.ok) {
                const errText = await response.text();
                throw new Error(`Gemini Image API error: ${response.status} - ${errText}`);
            }

            const result = await response.json();
            const part = result?.candidates?.[0]?.content?.parts?.find(p => p.inlineData);
            if (!part) throw new Error("Không nhận được dữ liệu hình ảnh từ Gemini AI.");
            return `data:${part.inlineData.mimeType};base64,${part.inlineData.data}`;
        }

        // --- MAIN APP COMPONENT ---
        function App() {
            const [activeTab, setActiveTab] = useState('home');
            const [selectedCultureItem, setSelectedCultureItem] = useState(CULTURAL_ITEMS[0]);
            const [isMobileMenuOpen, setIsMobileMenuOpen] = useState(false);
            const [viViOpen, setViViOpen] = useState(false);

            // Lightbox Modal Zoom State
            const [zoomImage, setZoomImage] = useState(null);

            // Badge Pop-up Congratulation Modal State
            const [congratBadge, setCongratBadge] = useState(null);

            // Badges & Lookbook Kho Lưu Trữ
            const [userBadges, setUserBadges] = useState([
                { 
                    id: 'tan-binh-di-san', 
                    title: 'Tân Binh Di Sản', 
                    icon: 'shield', 
                    colorTheme: 'bg-gradient-to-r from-blue-600 to-indigo-800 text-gold border-blue-400',
                    desc: 'Tham gia khám phá ứng dụng ViNO v5.0', 
                    date: '08/10/2026' 
                }
            ]);
            const [savedLookbook, setSavedLookbook] = useState([]);

            // Cultural Guardian
            const [isGuardianActive, setIsGuardianActive] = useState(true);
            const [isGuardianAlertOpen, setIsGuardianAlertOpen] = useState(false);
            const [guardianReason, setGuardianReason] = useState('');

            // Virtual Try-On States
            const [userAvatar, setUserAvatar] = useState(null);
            const [selectedOutfitId, setSelectedOutfitId] = useState('nhat-binh');
            const [selectedPose, setSelectedPose] = useState('Đứng thẳng');
            const [selectedArtStyle, setSelectedArtStyle] = useState('Chân Thực');
            const [selectedSetting, setSelectedSetting] = useState('Hoàng thành Thăng Long');
            const [customColor, setCustomColor] = useState('Đỏ son triều đình');
            const [selectedAccessories, setSelectedAccessories] = useState({
                headwear: 'Khăn vành dải màu Vàng (Hoàng gia)',
                hairpin: 'Trâm phượng triều Nguyễn'
            });
            const [variantModal, setVariantModal] = useState({ isOpen: false, accessoryItem: null });
            const [isRenderingImage, setIsRenderingImage] = useState(false);
            const [aiRenderedImage, setAiRenderedImage] = useState(null);
            const [backupFileName, setBackupFileName] = useState('');
            const [isBackupUsed, setIsBackupUsed] = useState(false);

            // Remix Minigame States
            const [gameTheme, setGameTheme] = useState(GAME_THEMES[0]);
            const [gameOutfit, setGameOutfit] = useState(CULTURAL_ITEMS[0]);
            const [activeAccCategoryTab, setActiveAccCategoryTab] = useState('head');
            const [gameSelectedAccs, setGameSelectedAccs] = useState([GLOBAL_ACCESSORIES[2].name, GLOBAL_ACCESSORIES[6].name]);
            const [gamePose, setGamePose] = useState('Đứng thẳng');
            const [gameArtStyle, setGameArtStyle] = useState('Chân Thực');
            const [isEvaluatingGame, setIsEvaluatingGame] = useState(false);
            const [gameEvalResult, setGameEvalResult] = useState(null);
            const [gameRenderedImage, setGameRenderedImage] = useState(null);
            const [gameEvalError, setGameEvalError] = useState('');

            // Chatbot ViVi States
            const [chatMessages, setChatMessages] = useState([
                { sender: 'bot', text: 'Xin chào! Tôi là ViVi v2.0 - Trợ lý AI của ViNO 5.0. Bạn cần hỗ trợ gì về Cổ phục Việt Nam hay các tính năng mới hôm nay?' }
            ]);
            const [inputMessage, setInputMessage] = useState('');
            const [isChatLoading, setIsChatLoading] = useState(false);
            const chatEndRef = useRef(null);

            useEffect(() => {
                if (window.lucide) {
                    window.lucide.createIcons();
                }
            }, [activeTab, selectedCultureItem, viViOpen, isGuardianAlertOpen, variantModal, gameEvalResult, activeAccCategoryTab, userBadges, zoomImage, congratBadge]);

            useEffect(() => {
                if (viViOpen && chatEndRef.current) {
                    chatEndRef.current.scrollIntoView({ behavior: 'smooth' });
                }
            }, [chatMessages, viViOpen]);

            // Hàm Mở Pop-up Trao Badge Mới Tức Thì
            const unlockBadge = (newBadge) => {
                if (!userBadges.some(b => b.id === newBadge.id)) {
                    const timestampStr = new Date().toLocaleString('vi-VN', {
                        hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit', year: 'numeric'
                    });
                    const fullBadgeObj = { ...newBadge, date: timestampStr };
                    setUserBadges(prev => [...prev, fullBadgeObj]);
                    setCongratBadge(fullBadgeObj); // Mở Pop-up chúc mừng ngay
                }
            };

            const currentCostumeObj = CULTURAL_ITEMS.find(c => c.id === selectedOutfitId) || CULTURAL_ITEMS[0];

            // Cultural Guardian check trong Phòng Thử Đồ AI
            const checkCulturalConflict = (outfitId, accessoryName) => {
                if (!isGuardianActive) return null;
                if (outfitId === 'nhat-binh' && (accessoryName.includes('Nón quai thao') || accessoryName.includes('Sneaker'))) {
                    return 'Cảnh báo Cultural Guardian: Áo Nhật Bình là trang phục Hoàng tộc, không nên phối ngẫu hứng với Nón Quai Thao thuộc dân gian hoặc Giày Sneaker hiện đại.';
                }
                if (outfitId === 'giao-linh' && accessoryName.includes('Sneaker')) {
                    return 'Cảnh báo Cultural Guardian: Áo Giao Lĩnh cổ triều đại nên kết hợp cùng Hài thêu hoa thay vì Giày Sneaker hiện đại.';
                }
                return null;
            };

            const handleAccessoryClick = (item) => {
                const currentSelected = selectedAccessories[item.slotId];
                if (currentSelected && (currentSelected === item.name || item.variants?.includes(currentSelected))) {
                    const updated = { ...selectedAccessories };
                    delete updated[item.slotId];
                    setSelectedAccessories(updated);
                    return;
                }

                if (item.variants && item.variants.length > 0) {
                    setVariantModal({ isOpen: true, accessoryItem: item });
                } else {
                    const conflictReason = checkCulturalConflict(selectedOutfitId, item.name);
                    if (conflictReason) {
                        setGuardianReason(conflictReason);
                        setIsGuardianAlertOpen(true);
                        return;
                    }
                    setSelectedAccessories(prev => ({ ...prev, [item.slotId]: item.name }));
                }
            };

            const handleSelectVariant = (variantName) => {
                const conflictReason = checkCulturalConflict(selectedOutfitId, variantName);
                if (conflictReason) {
                    setVariantModal({ isOpen: false, accessoryItem: null });
                    setGuardianReason(conflictReason);
                    setIsGuardianAlertOpen(true);
                    return;
                }
                setSelectedAccessories(prev => ({ ...prev, [variantModal.accessoryItem.slotId]: variantName }));
                setVariantModal({ isOpen: false, accessoryItem: null });
            };

            // AI Render Try-on với Nano Banana 2 Lite & Smart Drive Backup
            const handleRenderAIOutfit = async () => {
                setIsRenderingImage(true);
                setIsBackupUsed(false);
                setBackupFileName('');
                
                const accList = Object.values(selectedAccessories);
                const accString = accList.length > 0 ? accList.join(', ') : 'Trang phục nguyên bản';
                const avatarPromptPart = userAvatar ? "The generated person should resemble the uploaded user portrait face and body features. " : "";

                const prompt = `A breathtaking ${selectedArtStyle.toLowerCase()} portrait of a person wearing authentic traditional Vietnamese costume: ${currentCostumeObj.name} (${currentCostumeObj.subtitle}), with historic accessories: ${accString}. Pose: ${selectedPose}. Art Style: ${selectedArtStyle}. Primary color palette: ${customColor}. Set in the historic scene of ${selectedSetting}, Vietnam. ${avatarPromptPart} High cultural accuracy, rich textile details, 8k resolution.`;

                try {
                    const generatedImgUrl = await callGeminiImage({ prompt, aspectRatio: "3:4" });
                    setAiRenderedImage(generatedImgUrl);
                } catch (err) {
                    console.warn("AI Render API bận, kích hoạt Thuật Toán Backup Google Drive:", err);
                    const bestBackup = findBestBackupImage(selectedOutfitId, selectedArtStyle, selectedSetting, customColor);
                    setAiRenderedImage(bestBackup.url);
                    setBackupFileName(bestBackup.filename);
                    setIsBackupUsed(true);
                } finally {
                    setIsRenderingImage(false);
                }
            };

            // Remix Minigame Accessory Toggle + Tag Validation Check
            const toggleRemixAccessory = (acc) => {
                const isSelected = gameSelectedAccs.includes(acc.name);
                if (isSelected) {
                    setGameSelectedAccs(gameSelectedAccs.filter(a => a !== acc.name));
                    return;
                }

                const costumeTag = gameOutfit.id; 
                const isValidTag = acc.tags && acc.tags.includes(costumeTag);

                if (isGuardianActive && !isValidTag) {
                    setGuardianReason(`Cảnh báo Cultural Guardian: Phụ kiện "${acc.name}" không có thẻ văn hóa tương thích với [${gameOutfit.name}]. Bạn nên chọn phụ kiện đúng thẻ chuẩn mực hoặc tắt Cultural Guardian để tự do Remix!`);
                    setIsGuardianAlertOpen(true);
                    return;
                }

                setGameSelectedAccs([...gameSelectedAccs, acc.name]);
            };

            // Remix Minigame Evaluate & Check Trao 3 Badges
            const handleEvaluateGameOutfit = async () => {
                setIsEvaluatingGame(true);
                setGameEvalError('');
                setGameEvalResult(null);

                const accStr = gameSelectedAccs.length > 0 ? gameSelectedAccs.join(', ') : 'Không dùng phụ kiện';

                const promptText = `
Chủ đề thi đấu: "${gameTheme.title}" (${gameTheme.description}).
Trang phục người chơi chọn: ${gameOutfit.name}.
Danh sách phụ kiện đã phối: ${accStr}.
Dáng pose: ${gamePose}.
Phong cách nghệ thuật: ${gameArtStyle}.

Hãy đánh giá bài phối đồ này trên 3 tiêu chí theo thang điểm từ 0 đến 100:
1. fitScore (Tính phù hợp): Mức độ đúng chủ đề, tôn trọng văn hóa.
2. creativeScore (Tính sáng tạo): Mức độ kết hợp độc đáo, gu thẩm mỹ phối màu.
3. diversityScore (Tính đa dạng): Mức độ phong phú trong việc chọn và phối hợp phụ kiện.
                `;

                const responseSchema = {
                    type: "OBJECT",
                    properties: {
                        fitScore: { type: "NUMBER" },
                        creativeScore: { type: "NUMBER" },
                        diversityScore: { type: "NUMBER" },
                        feedback: { type: "STRING" }
                    },
                    required: ["fitScore", "creativeScore", "diversityScore", "feedback"]
                };

                try {
                    const evalText = await callGeminiText({
                        prompt: promptText,
                        systemInstruction: "Bạn là Giám Khảo AI chuyên gia thời trang Việt Phục Remix. Hãy chấm điểm nghiêm túc, công bằng và trả về kết quả JSON duy nhất.",
                        responseSchema: responseSchema
                    });

                    const parsedEval = JSON.parse(evalText);
                    setGameEvalResult(parsedEval);

                    // XÉT DUYỆT TRAO BADGES THEO TIÊU CHÍ V5.0
                    if (parsedEval.fitScore >= 80) {
                        unlockBadge({
                            id: 'phoi-do-chuan-phong-cach',
                            title: 'Phối Đồ Chuẩn Phong Cách',
                            icon: 'check-circle-2',
                            colorTheme: 'bg-gradient-to-r from-emerald-600 to-teal-800 text-gold border-emerald-400',
                            desc: 'Đạt điểm Chính Xác (fitScore) >= 80 trong Việt Phục Remix!'
                        });
                    }
                    if (parsedEval.creativeScore >= 80) {
                        unlockBadge({
                            id: 'nguoi-doi-moi-thoi-trang',
                            title: 'Người Đổi Mới Thời Trang',
                            icon: 'sparkles',
                            colorTheme: 'bg-gradient-to-r from-purple-600 to-indigo-900 text-gold border-purple-400',
                            desc: 'Đạt điểm Sáng Tạo (creativeScore) >= 80 trong Việt Phục Remix!'
                        });
                    }
                    if (parsedEval.diversityScore >= 80) {
                        unlockBadge({
                            id: 'thien-bien-van-hoa',
                            title: 'Thiên Biến Vạn Hóa',
                            icon: 'layers',
                            colorTheme: 'bg-gradient-to-r from-amber-500 to-orange-700 text-navy border-amber-300',
                            desc: 'Đạt điểm Đa Dạng (diversityScore) >= 80 trong Việt Phục Remix!'
                        });
                    }

                    const imagePrompt = `A stunning cultural fashion portrait of traditional Vietnamese garment ${gameOutfit.name}, styled with accessories: ${accStr}, pose: ${gamePose}, art style: ${gameArtStyle}. High detail, cinematic lighting.`;
                    try {
                        const imgUrl = await callGeminiImage({ prompt: imagePrompt, aspectRatio: "3:4" });
                        setGameRenderedImage(imgUrl);
                    } catch (iErr) {
                        const backupImg = findBestBackupImage(gameOutfit.id, gameArtStyle, 'Hoàng thành Thăng Long', 'Đỏ');
                        setGameRenderedImage(backupImg.url);
                    }

                } catch (err) {
                    console.error("Game Eval error:", err);
                    setGameEvalError('Đã có lỗi xảy ra trong quá trình chấm điểm của Gemini AI. Vui lòng bấm thử lại!');
                } finally {
                    setIsEvaluatingGame(false);
                }
            };

            // Chatbot ViVi Send Message
            const handleSendMessage = async (textToSend) => {
                const query = textToSend || inputMessage;
                if (!query.trim() || isChatLoading) return;

                const updatedMessages = [...chatMessages, { sender: 'user', text: query }];
                setChatMessages(updatedMessages);
                if (!textToSend) setInputMessage('');
                setIsChatLoading(true);

                try {
                    const historyForGemini = updatedMessages.map(m => ({
                        role: m.sender === 'user' ? 'user' : 'model',
                        parts: [{ text: m.text }]
                    }));
                    historyForGemini.pop();

                    const aiReply = await callGeminiText({
                        prompt: query,
                        systemInstruction: VIVI_SYSTEM_INSTRUCTION,
                        chatHistory: historyForGemini
                    });

                    setChatMessages(prev => [...prev, { sender: 'bot', text: aiReply }]);
                } catch (err) {
                    console.error("ViVi Chat error:", err);
                    setChatMessages(prev => [...prev, { 
                        sender: 'bot', 
                        text: 'Tôi muốn đảm bảo thông tin chính xác nhất cho bạn, nhưng hiện tại kết nối gặp gián đoạn nhỏ. Bạn vui lòng thử lại sau giây lát nhé!' 
                    }]);
                } finally {
                    setIsChatLoading(false);
                }
            };

            return (
                <div className="min-h-screen flex flex-col lg:flex-row bg-cream text-navy">
                    
                    {/* CỘT SIDEBAR ĐIỀU HƯỚNG (VINO 5.0) */}
                    <aside className={`fixed inset-y-0 left-0 z-40 w-72 bg-navy text-cream transform ${isMobileMenuOpen ? 'translate-x-0' : '-translate-x-full'} lg:translate-x-0 transition-transform duration-300 ease-in-out flex flex-col justify-between border-r border-gold/30 shadow-2xl`}>
                        <div>
                            {/* Logo */}
                            <div className="p-6 text-center border-b border-gold/20 relative">
                                <div className="w-16 h-16 mx-auto mb-3 rounded-full crimson-gradient border-2 border-gold flex items-center justify-center shadow-lg">
                                    <span className="font-playfair text-2xl font-bold text-gold tracking-widest">ViNO</span>
                                </div>
                                <h1 className="font-playfair text-xl font-bold text-gold tracking-wide">Vietnam New Outlook</h1>
                                <p className="text-xs text-amber-200/70 mt-1 uppercase tracking-widest">Di Sản Cổ Phục Việt v5.0</p>
                                <button 
                                    onClick={() => setIsMobileMenuOpen(false)}
                                    className="lg:hidden absolute top-4 right-4 text-cream hover:text-gold"
                                >
                                    <i data-lucide="x" className="w-6 h-6"></i>
                                </button>
                            </div>

                            {/* Sidebar Nav Items */}
                            <nav className="p-4 space-y-1.5">
                                {[
                                    { id: 'home', label: 'Trang Chủ Cổ Phục', icon: 'book-open' },
                                    { id: 'tryon', label: 'Phòng Thử Đồ AI', icon: 'sparkles' },
                                    { id: 'museum', label: 'Bảo Tàng 3D', icon: 'box' },
                                    { id: 'remix', label: 'Việt Phục Remix', icon: 'gamepad-2' },
                                    { id: 'quiz', label: 'Kiểm Tra Lịch Sử', icon: 'award' },
                                    { id: 'shops', label: 'Cửa Hàng Tiệm May', icon: 'map-pin' },
                                    { id: 'storage', label: 'Kho Lưu Trữ', icon: 'archive' }
                                ].map((nav) => (
                                    <button
                                        key={nav.id}
                                        onClick={() => {
                                            setActiveTab(nav.id);
                                            setIsMobileMenuOpen(false);
                                        }}
                                        className={`w-full flex items-center space-x-3.5 px-4 py-3 rounded-xl font-medium transition-all duration-200 ${
                                            activeTab === nav.id
                                                ? 'gold-gradient text-navy font-semibold shadow-md'
                                                : 'text-gray-300 hover:bg-white/10 hover:text-gold'
                                        }`}
                                    >
                                        <i data-lucide={nav.icon} className="w-5 h-5"></i>
                                        <span className="text-sm tracking-wide">{nav.label}</span>
                                    </button>
                                ))}
                            </nav>
                        </div>

                        {/* Sidebar Footer */}
                        <div className="p-5 border-t border-gold/20 text-center text-xs text-amber-200/60">
                            <p className="font-semibold text-gold mb-1">Đội ngũ phát triển ViNO:</p>
                            <p className="text-[11px] text-gray-300">Nguyễn Hoàng Minh</p>
                            <p className="text-[11px] text-gray-300">Nguyễn Trần Ánh Linh</p>
                            <p className="text-[11px] text-gray-300">Trần Tuấn Phong</p>
                            <p className="mt-2 text-[10px] text-gray-400">© 2026 ViNO Project v5.0</p>
                        </div>
                    </aside>

                    {/* Mobile Header Bar */}
                    <div className="lg:hidden bg-navy text-cream p-4 flex items-center justify-between sticky top-0 z-30 shadow-md border-b border-gold/20">
                        <div className="flex items-center space-x-3">
                            <div className="w-8 h-8 rounded-full crimson-gradient border border-gold flex items-center justify-center font-playfair font-bold text-gold text-xs">VN</div>
                            <span className="font-playfair font-bold text-gold tracking-wide">Vietnam New Outlook</span>
                        </div>
                        <button 
                            onClick={() => setIsMobileMenuOpen(true)}
                            className="p-2 text-gold focus:outline-none"
                        >
                            <i data-lucide="menu" className="w-6 h-6"></i>
                        </button>
                    </div>

                    {/* CỘT NỘI DUNG CHÍNH (MAIN CONTENT) */}
                    <main className="flex-1 lg:ml-72 min-h-screen p-4 sm:p-6 md:p-8 bg-cream/50 overflow-x-hidden">
                        {activeTab === 'home' && (
                            <HomeView 
                                selectedCulture={selectedCultureItem} 
                                onSelectCulture={setSelectedCultureItem} 
                                onGoToTryOn={(id) => { setSelectedOutfitId(id); setActiveTab('tryon'); }}
                                onImageClick={(url) => setZoomImage(url)}
                            />
                        )}
                        {activeTab === 'tryon' && (
                            <VirtualTryOnView 
                                userAvatar={userAvatar}
                                setUserAvatar={setUserAvatar}
                                selectedOutfitId={selectedOutfitId}
                                setSelectedOutfitId={setSelectedOutfitId}
                                selectedPose={selectedPose}
                                setSelectedPose={setSelectedPose}
                                selectedArtStyle={selectedArtStyle}
                                setSelectedArtStyle={setSelectedArtStyle}
                                selectedSetting={selectedSetting}
                                setSelectedSetting={setSelectedSetting}
                                customColor={customColor}
                                setCustomColor={setCustomColor}
                                selectedAccessories={selectedAccessories}
                                handleAccessoryClick={handleAccessoryClick}
                                isGuardianActive={isGuardianActive}
                                setIsGuardianActive={setIsGuardianActive}
                                handleRenderAIOutfit={handleRenderAIOutfit}
                                isRenderingImage={isRenderingImage}
                                aiRenderedImage={aiRenderedImage}
                                backupFileName={backupFileName}
                                isBackupUsed={isBackupUsed}
                                savedLookbook={savedLookbook}
                                setSavedLookbook={setSavedLookbook}
                                costumeData={CULTURAL_ITEMS}
                                onImageClick={(url) => setZoomImage(url)}
                            />
                        )}
                        {activeTab === 'museum' && <Museum3DView />}
                        {activeTab === 'remix' && (
                            <MinigameRemixView 
                                gameTheme={gameTheme}
                                setGameTheme={setGameTheme}
                                gameOutfit={gameOutfit}
                                setGameOutfit={setGameOutfit}
                                activeAccCategoryTab={activeAccCategoryTab}
                                setActiveAccCategoryTab={setActiveAccCategoryTab}
                                gameSelectedAccs={gameSelectedAccs}
                                toggleRemixAccessory={toggleRemixAccessory}
                                gamePose={gamePose}
                                setGamePose={setGamePose}
                                gameArtStyle={gameArtStyle}
                                setGameArtStyle={setGameArtStyle}
                                handleEvaluateGameOutfit={handleEvaluateGameOutfit}
                                isEvaluatingGame={isEvaluatingGame}
                                gameEvalResult={gameEvalResult}
                                gameRenderedImage={gameRenderedImage}
                                gameEvalError={gameEvalError}
                                savedLookbook={savedLookbook}
                                setSavedLookbook={setSavedLookbook}
                                costumeData={CULTURAL_ITEMS}
                                onImageClick={(url) => setZoomImage(url)}
                            />
                        )}
                        {activeTab === 'quiz' && (
                            <QuizView unlockBadge={unlockBadge} onGoToStorage={() => setActiveTab('storage')} />
                        )}
                        {activeTab === 'shops' && <ShopsView />}
                        {activeTab === 'storage' && (
                            <StorageView 
                                savedLookbook={savedLookbook} 
                                userBadges={userBadges} 
                                onImageClick={(url) => setZoomImage(url)}
                            />
                        )}
                    </main>

                    {/* MODAL CỬA SỔ PHÓNG TO ÁNH (IMAGE LIGHTBOX & DOWNLOAD) */}
                    {zoomImage && (
                        <div className="fixed inset-0 z-50 bg-black/90 backdrop-blur-md flex items-center justify-center p-4 animate-fadeIn">
                            <div className="relative max-w-4xl w-full flex flex-col items-center">
                                {/* Action Buttons Header */}
                                <div className="w-full flex justify-between items-center mb-3 px-2">
                                    <a
                                        href={zoomImage}
                                        download="ViNO-Costume-Image.png"
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        className="bg-gold text-navy px-4 py-2 rounded-full font-bold text-xs flex items-center space-x-2 shadow-lg hover:bg-white transition"
                                    >
                                        <i data-lucide="download" className="w-4 h-4"></i>
                                        <span>Tải Ảnh Về Máy</span>
                                    </a>
                                    <button 
                                        onClick={() => setZoomImage(null)}
                                        className="w-10 h-10 bg-white/20 hover:bg-crimson text-white rounded-full flex items-center justify-center transition"
                                    >
                                        <i data-lucide="x" className="w-6 h-6"></i>
                                    </button>
                                </div>
                                {/* Zoomed Image Container */}
                                <div className="max-h-[80vh] overflow-hidden rounded-2xl border-2 border-gold/50 shadow-2xl">
                                    <img src={zoomImage} alt="Zoomed View" className="max-h-[80vh] w-auto object-contain mx-auto" />
                                </div>
                            </div>
                        </div>
                    )}

                    {/* MODAL POP-UP CHÚC MỪNG NHẬN BADGE MỚI */}
                    {congratBadge && (
                        <div className="fixed inset-0 z-50 bg-navy/85 backdrop-blur-md flex items-center justify-center p-4">
                            <div className="bg-white max-w-md w-full rounded-3xl p-6 sm:p-8 border-4 border-gold text-center space-y-4 shadow-2xl animate-pop relative">
                                <button 
                                    onClick={() => setCongratBadge(null)}
                                    className="absolute top-4 right-4 text-gray-400 hover:text-crimson"
                                >
                                    <i data-lucide="x" className="w-6 h-6"></i>
                                </button>
                                
                                <div className="w-20 h-20 mx-auto rounded-3xl crimson-gradient border-2 border-gold flex items-center justify-center text-gold shadow-xl">
                                    <i data-lucide={congratBadge.icon || 'award'} className="w-10 h-10"></i>
                                </div>

                                <span className="inline-block bg-amber-100 text-amber-900 font-bold text-[10px] uppercase px-3 py-1 rounded-full border border-amber-300">
                                    🎉 Mở Khóa Danh Hiệu Mới!
                                </span>

                                <h3 className="font-playfair text-2xl font-bold text-navy">{congratBadge.title}</h3>
                                <p className="text-xs text-gray-600 leading-relaxed">{congratBadge.desc}</p>
                                
                                <div className="bg-cream p-3 rounded-xl border border-gold/30 text-[11px] text-teal font-semibold">
                                    Thời điểm mở khóa: {congratBadge.date}
                                </div>

                                <button 
                                    onClick={() => {
                                        setCongratBadge(null);
                                        setActiveTab('storage');
                                    }}
                                    className="w-full bg-crimson text-gold py-3.5 rounded-xl font-bold text-xs shadow-lg hover:bg-vermilion transition"
                                >
                                    Xem Trong Kho Lưu Trữ
                                </button>
                            </div>
                        </div>
                    )}

                    {/* MODAL CẢNH BÁO CULTURAL GUARDIAN */}
                    {isGuardianAlertOpen && (
                        <div className="fixed inset-0 z-50 bg-navy/85 backdrop-blur-sm flex items-center justify-center p-4">
                            <div className="bg-white max-w-md w-full rounded-3xl p-6 border-2 border-vermilion space-y-4 text-center shadow-2xl">
                                <div className="w-12 h-12 bg-red-100 text-vermilion rounded-full flex items-center justify-center mx-auto">
                                    <i data-lucide="shield-alert" className="w-7 h-7"></i>
                                </div>
                                <h3 className="font-playfair text-lg font-bold text-crimson">Cảnh Báo Cultural Guardian</h3>
                                <p className="text-xs text-gray-600 leading-relaxed">{guardianReason}</p>
                                <button 
                                    onClick={() => setIsGuardianAlertOpen(false)}
                                    className="w-full bg-crimson text-gold py-3 rounded-xl font-bold text-xs shadow-md hover:bg-vermilion transition"
                                >
                                    Đã Hiểu & Đổi Tùy Chọn
                                </button>
                            </div>
                        </div>
                    )}

                    {/* MODAL CHỌN BIẾN THỂ PHỤ KIỆN */}
                    {variantModal.isOpen && variantModal.accessoryItem && (
                        <div className="fixed inset-0 z-50 bg-navy/80 backdrop-blur-sm flex items-center justify-center p-4">
                            <div className="bg-white max-w-sm w-full rounded-3xl p-6 border-2 border-gold shadow-2xl space-y-4">
                                <div className="flex justify-between items-center border-b border-cream pb-3">
                                    <div>
                                        <span className="text-[10px] text-crimson font-bold uppercase tracking-wider">
                                            {variantModal.accessoryItem.categoryName}
                                        </span>
                                        <h3 className="font-playfair font-bold text-base text-navy">
                                            Chọn {variantModal.accessoryItem.name}
                                        </h3>
                                    </div>
                                    <button onClick={() => setVariantModal({ isOpen: false, accessoryItem: null })} className="text-gray-400 hover:text-crimson">
                                        <i data-lucide="x" className="w-5 h-5"></i>
                                    </button>
                                </div>

                                <div className="space-y-2">
                                    {variantModal.accessoryItem.variants.map((v, idx) => (
                                        <button
                                            key={idx}
                                            onClick={() => handleSelectVariant(v)}
                                            className="w-full text-left p-3.5 rounded-2xl bg-cream hover:bg-gold hover:text-navy border border-gold/30 text-xs font-bold transition flex items-center justify-between group"
                                        >
                                            <span>{v}</span>
                                            <i data-lucide="chevron-right" className="w-4 h-4 text-crimson group-hover:text-navy"></i>
                                        </button>
                                    ))}
                                </div>
                            </div>
                        </div>
                    )}

                    {/* FLOATING AI ASSISTANT VIVI BUTTON */}
                    <div className="fixed bottom-6 right-6 z-50">
                        <button
                            onClick={() => setViViOpen(!viViOpen)}
                            className="w-14 h-14 rounded-full crimson-gradient border-2 border-gold shadow-2xl flex items-center justify-center text-gold hover:scale-105 transition-all duration-300 group"
                            title="Mở Trợ Lý AI ViVi v2.0"
                        >
                            <i data-lucide={viViOpen ? "x" : "bot"} className="w-7 h-7 group-hover:rotate-12 transition-transform"></i>
                        </button>
                    </div>

                    {/* AI VIVI CHAT DRAWER */}
                    {viViOpen && (
                        <div className="fixed bottom-24 right-6 z-50 w-80 sm:w-96 bg-white rounded-3xl shadow-2xl border-2 border-gold/40 overflow-hidden flex flex-col h-[500px] transition duration-300">
                            <div className="bg-navy text-cream p-4 border-b border-gold/30 flex items-center justify-between">
                                <div className="flex items-center space-x-3">
                                    <div className="w-9 h-9 rounded-2xl crimson-gradient flex items-center justify-center text-gold border border-gold/40 font-playfair font-bold text-xs">
                                        ViVi
                                    </div>
                                    <div>
                                        <h4 className="font-bold text-xs text-gold">ViVi v2.0 - Trợ Lý AI ViNO 5.0</h4>
                                        <p className="text-[10px] text-emerald-400 font-medium">gemini-3.1-flash-lite</p>
                                    </div>
                                </div>
                                <button onClick={() => setViViOpen(false)} className="text-gray-300 hover:text-white">
                                    <i data-lucide="x" className="w-5 h-5"></i>
                                </button>
                            </div>

                            <div className="flex-1 p-4 overflow-y-auto space-y-3 bg-cream/30 text-xs">
                                {chatMessages.map((msg, index) => (
                                    <div key={index} className={`flex ${msg.sender === 'user' ? 'justify-end' : 'justify-start'}`}>
                                        <div className={`max-w-[85%] p-3 rounded-2xl leading-relaxed ${
                                            msg.sender === 'user' 
                                                ? 'bg-crimson text-white rounded-br-none shadow-sm' 
                                                : 'bg-white text-navy border border-gold/30 rounded-bl-none shadow-sm'
                                        }`}>
                                            {msg.text}
                                        </div>
                                    </div>
                                ))}
                                {isChatLoading && (
                                    <div className="flex justify-start">
                                        <div className="bg-white text-navy p-2.5 rounded-2xl border border-gold/30 text-xs italic flex items-center space-x-2">
                                            <div className="w-2 h-2 rounded-full bg-crimson animate-ping"></div>
                                            <span>ViVi v2.0 đang suy nghĩ...</span>
                                        </div>
                                    </div>
                                )}
                                <div ref={chatEndRef} />
                            </div>

                            {/* Suggestion Chips */}
                            <div className="p-2 bg-white border-t border-gold/20 flex overflow-x-auto space-x-2 text-[10px]">
                                <button onClick={() => handleSendMessage("Bộ 10 câu hỏi trắc nghiệm lịch sử hoạt động ra sao?")} className="px-2.5 py-1 bg-cream rounded-full whitespace-nowrap text-navy hover:bg-gold/30 border border-gold/30">
                                    Quiz 10 Câu Hỏi
                                </button>
                                <button onClick={() => handleSendMessage("Các Badge trong Việt Phục Remix gồm những gì?")} className="px-2.5 py-1 bg-cream rounded-full whitespace-nowrap text-navy hover:bg-gold/30 border border-gold/30">
                                    Hệ thống Badges
                                </button>
                            </div>

                            <div className="p-3 bg-white border-t border-gold/20 flex items-center space-x-2">
                                <input 
                                    type="text" 
                                    value={inputMessage}
                                    onChange={(e) => setInputMessage(e.target.value)}
                                    onKeyDown={(e) => e.key === 'Enter' && handleSendMessage()}
                                    placeholder="Nhập tin nhắn cho ViVi v2.0..."
                                    className="flex-1 bg-cream/60 text-xs text-navy px-3 py-2 rounded-full border border-gold/30 focus:outline-none"
                                />
                                <button 
                                    onClick={() => handleSendMessage()}
                                    disabled={isChatLoading}
                                    className="p-2 bg-crimson text-gold rounded-full hover:bg-vermilion transition disabled:opacity-50"
                                >
                                    <i data-lucide="send" className="w-4 h-4"></i>
                                </button>
                            </div>
                        </div>
                    )}

                </div>
            );
        }

        // --- SUB-VIEWS COMPONENTS ---

        // 1. TRANG CHỦ & THẺ VĂN HÓA
        function HomeView({ selectedCulture, onSelectCulture, onGoToTryOn, onImageClick }) {
            const [detailSubTab, setDetailSubTab] = useState('history');

            return (
                <div className="max-w-6xl mx-auto space-y-8 animate-fadeIn">
                    {/* Hero Banner */}
                    <div className="relative rounded-2xl overflow-hidden crimson-gradient border border-gold/40 shadow-xl p-8 sm:p-12 text-cream">
                        <div className="relative z-10 max-w-2xl">
                            <span className="inline-block px-3 py-1 rounded-full bg-gold/20 text-gold text-xs font-semibold uppercase tracking-wider mb-3 border border-gold/30">
                                Vietnam New Outlook 5.0
                            </span>
                            <h2 className="font-playfair text-3xl sm:text-4xl md:text-5xl font-bold text-amber-100 leading-tight">
                                Tôn Vinh Di Sản Văn Hóa & Cổ Phục Việt
                            </h2>
                            <p className="mt-4 text-amber-100/80 text-sm sm:text-base leading-relaxed">
                                Hiểu văn hóa để biết cách Trân Trọng
                            </p>
                        </div>
                    </div>

                    {/* Culture Selector Tabs */}
                    <div className="flex flex-wrap gap-3 border-b border-gold/20 pb-4">
                        {CULTURAL_ITEMS.map((item) => (
                            <button
                                key={item.id}
                                onClick={() => onSelectCulture(item)}
                                className={`px-5 py-2.5 rounded-full font-medium text-sm transition-all duration-200 border ${
                                    selectedCulture.id === item.id
                                        ? 'bg-crimson text-gold border-gold shadow-md font-semibold'
                                        : 'bg-white text-navy border-gray-200 hover:border-gold hover:text-crimson'
                                }`}
                            >
                                {item.name}
                            </button>
                        ))}
                    </div>

                    {/* Detailed Culture Card Section */}
                    <div className="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                        <div className="lg:col-span-7 bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-gold/20 space-y-6">
                            <div>
                                <div className="flex items-center justify-between">
                                    <span className="text-xs font-semibold text-crimson uppercase tracking-wider bg-red-50 px-3 py-1 rounded-md border border-red-100">
                                        {selectedCulture.dynasty}
                                    </span>
                                    <span className="text-xs text-gray-500 italic">{selectedCulture.role}</span>
                                </div>
                                <h3 className="font-playfair text-3xl font-bold text-navy mt-3">{selectedCulture.name}</h3>
                                <p className="mt-3 text-gray-700 leading-relaxed text-sm sm:text-base">
                                    {selectedCulture.summary}
                                </p>
                            </div>

                            {/* Sub Tabs: Lịch Sử / Ý Nghĩa / Chất Liệu */}
                            <div className="flex border-b border-gold/20 space-x-6 text-xs font-bold pt-2">
                                <button 
                                    onClick={() => setDetailSubTab('history')}
                                    className={`pb-2 border-b-2 uppercase tracking-wide ${detailSubTab === 'history' ? 'border-crimson text-crimson' : 'border-transparent text-gray-500'}`}
                                >
                                    Lịch Sử & Tiến Trình
                                </button>
                                <button 
                                    onClick={() => setDetailSubTab('meaning')}
                                    className={`pb-2 border-b-2 uppercase tracking-wide ${detailSubTab === 'meaning' ? 'border-crimson text-crimson' : 'border-transparent text-gray-500'}`}
                                >
                                    Triết Lý & Ý Nghĩa
                                </button>
                                <button 
                                    onClick={() => setDetailSubTab('materials')}
                                    className={`pb-2 border-b-2 uppercase tracking-wide ${detailSubTab === 'materials' ? 'border-crimson text-crimson' : 'border-transparent text-gray-500'}`}
                                >
                                    Chất Liệu & Họa Tiết
                                </button>
                            </div>

                            <div className="bg-cream/60 p-4 rounded-xl border border-gold/20 text-sm text-gray-700 leading-relaxed">
                                {detailSubTab === 'history' && <p>{selectedCulture.history}</p>}
                                {detailSubTab === 'meaning' && <p>{selectedCulture.meaning}</p>}
                                {detailSubTab === 'materials' && <p>{selectedCulture.material}</p>}
                            </div>

                            <button 
                                onClick={() => onGoToTryOn(selectedCulture.id)}
                                className="w-full bg-crimson text-gold py-3.5 rounded-xl font-bold text-sm shadow-md hover:bg-vermilion transition flex items-center justify-center space-x-2"
                            >
                                <i data-lucide="sparkles" className="w-4 h-4"></i>
                                <span>Thử Đồ Ảo Ngay Với {selectedCulture.name}</span>
                            </button>
                        </div>

                        {/* Gallery Section với Phóng To Ảnh */}
                        <div className="lg:col-span-5 space-y-4">
                            <h4 className="text-xs font-bold uppercase tracking-wider text-navy flex items-center justify-between">
                                <span className="flex items-center space-x-2">
                                    <i data-lucide="image" className="w-4 h-4 text-gold"></i>
                                    <span>Bộ Sưu Tập Ảnh Tư Liệu ({selectedCulture.gallery.length})</span>
                                </span>
                                <span className="text-[10px] text-teal font-normal">(Bấm vào ảnh để phóng to)</span>
                            </h4>
                            <div className="grid grid-cols-2 gap-3">
                                {selectedCulture.gallery.map((imgUrl, i) => (
                                    <div 
                                        key={i} 
                                        onClick={() => onImageClick(imgUrl)}
                                        className="relative rounded-2xl overflow-hidden shadow-md border border-gold/20 group h-44 bg-cream cursor-pointer"
                                    >
                                        <img 
                                            src={imgUrl} 
                                            alt={`${selectedCulture.name} ${i+1}`}
                                            className="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                        />
                                        <div className="absolute inset-0 bg-black/30 opacity-0 group-hover:opacity-100 transition flex items-center justify-center text-white text-xs font-bold gap-1">
                                            <i data-lucide="maximize-2" className="w-4 h-4"></i> Phóng To
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </div>
                    </div>
                </div>
            );
        }

        // 2. PHÒNG THỬ ĐỒ ẢO AI
        function VirtualTryOnView({
            userAvatar, setUserAvatar,
            selectedOutfitId, setSelectedOutfitId,
            selectedPose, setSelectedPose,
            selectedArtStyle, setSelectedArtStyle,
            selectedSetting, setSelectedSetting,
            customColor, setCustomColor,
            selectedAccessories, handleAccessoryClick,
            isGuardianActive, setIsGuardianActive,
            handleRenderAIOutfit, isRenderingImage,
            aiRenderedImage, backupFileName, isBackupUsed,
            savedLookbook, setSavedLookbook, costumeData, onImageClick
        }) {
            const currentObj = costumeData.find(c => c.id === selectedOutfitId) || costumeData[0];

            const handleAvatarUpload = (e) => {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onloadend = () => setUserAvatar(reader.result);
                    reader.readAsDataURL(file);
                }
            };

            return (
                <div className="max-w-5xl mx-auto space-y-8 animate-fadeIn">
                    <div className="flex flex-col sm:flex-row items-center justify-between gap-4 bg-navy text-cream p-6 rounded-2xl border border-gold/30 shadow-md">
                        <div>
                            <div className="flex items-center space-x-2">
                                <span className="text-xs font-semibold text-gold uppercase tracking-widest">Model: {AI_IMAGE_MODEL_NAME}</span>
                                <span className="text-[10px] bg-emerald-500 text-white font-bold px-2 py-0.5 rounded-full">Drive Backup Ready</span>
                            </div>
                            <h2 className="font-playfair text-2xl sm:text-3xl font-bold text-amber-100 mt-1">Phòng Thử Đồ Ảo AI</h2>
                            <p className="text-amber-100/70 text-xs sm:text-sm mt-1">
                                Render phong cách cổ phục bằng AI và tự động backup dữ liệu khi gián đoạn!
                            </p>
                        </div>
                        <button 
                            onClick={() => setIsGuardianActive(!isGuardianActive)}
                            className={`flex items-center space-x-2 px-4 py-2 rounded-full border text-xs font-bold transition shrink-0 ${
                                isGuardianActive ? 'bg-crimson/80 border-gold text-gold' : 'bg-gray-800 border-gray-600 text-gray-300'
                            }`}
                        >
                            <i data-lucide="shield-check" className="w-4 h-4"></i>
                            <span>Cultural Guardian: {isGuardianActive ? 'BẬT' : 'TẮT'}</span>
                        </button>
                    </div>

                    <div className="grid grid-cols-1 lg:grid-cols-12 gap-8">
                        {/* Control Panel */}
                        <div className="lg:col-span-6 bg-white rounded-2xl p-6 shadow-sm border border-gold/20 space-y-5">
                            {/* 1. Upload Avatar */}
                            <div>
                                <label className="block text-xs font-bold text-navy uppercase tracking-wider mb-2">
                                    1. Tải ảnh chân dung đại diện
                                </label>
                                <div className="border-2 border-dashed border-gold/40 rounded-xl p-4 text-center bg-cream/30 hover:bg-cream/60 transition relative">
                                    <input 
                                        type="file" 
                                        accept="image/*" 
                                        onChange={handleAvatarUpload}
                                        className="absolute inset-0 opacity-0 cursor-pointer w-full h-full"
                                    />
                                    {userAvatar ? (
                                        <div className="flex items-center justify-between">
                                            <div className="flex items-center space-x-3">
                                                <img src={userAvatar} alt="Uploaded" className="w-12 h-12 object-cover rounded-lg border border-gold" />
                                                <span className="text-xs font-medium text-emerald-700">Đã tải ảnh khuôn mặt!</span>
                                            </div>
                                            <button onClick={() => setUserAvatar(null)} className="text-gray-400 hover:text-crimson z-10">
                                                <i data-lucide="x" className="w-5 h-5"></i>
                                            </button>
                                        </div>
                                    ) : (
                                        <div className="py-2">
                                            <i data-lucide="camera" className="w-7 h-7 text-gold mx-auto mb-1"></i>
                                            <p className="text-xs text-gray-600 font-medium">Bấm hoặc kéo thả ảnh khuôn mặt cá nhân vào đây</p>
                                        </div>
                                    )}
                                </div>
                            </div>

                            {/* 2. Select Costume */}
                            <div>
                                <label className="block text-xs font-bold text-navy uppercase tracking-wider mb-2">2. Chọn Loại Trang Phục</label>
                                <select 
                                    value={selectedOutfitId} 
                                    onChange={(e) => setSelectedOutfitId(e.target.value)}
                                    className="w-full bg-cream/50 border border-gold/30 rounded-xl px-4 py-2.5 text-xs font-bold text-navy focus:outline-none"
                                >
                                    {costumeData.map(c => (
                                        <option key={c.id} value={c.id}>{c.name} ({c.subtitle})</option>
                                    ))}
                                </select>
                            </div>

                            {/* 3. Accessories Slot */}
                            <div>
                                <label className="block text-xs font-bold text-navy uppercase tracking-wider mb-2">3. Chọn Phụ Kiện Đi Kèm</label>
                                <div className="space-y-2">
                                    {currentObj.accessories?.map((accItem, idx) => {
                                        const selectedVal = selectedAccessories[accItem.slotId];
                                        const isSelected = !!selectedVal;
                                        return (
                                            <div key={idx} className="bg-cream/40 p-2.5 rounded-xl border border-gold/20 flex justify-between items-center text-xs">
                                                <span className="font-bold text-teal">{accItem.categoryName}:</span>
                                                <button
                                                    onClick={() => handleAccessoryClick(accItem)}
                                                    className={`px-3 py-1.5 rounded-lg text-xs font-bold border transition ${
                                                        isSelected ? 'bg-gold text-navy border-gold' : 'bg-white text-navy border-gray-200 hover:border-gold'
                                                    }`}
                                                >
                                                    {isSelected ? selectedVal : `+ ${accItem.name}`}
                                                </button>
                                            </div>
                                        );
                                    })}
                                </div>
                            </div>

                            {/* 4. Pose & Art Style */}
                            <div className="grid grid-cols-2 gap-3">
                                <div>
                                    <label className="block text-xs font-bold text-navy uppercase tracking-wider mb-1.5">4. Tư thế Pose</label>
                                    <select value={selectedPose} onChange={(e) => setSelectedPose(e.target.value)} className="w-full bg-cream/50 border border-gold/30 rounded-xl p-2.5 text-xs font-bold text-navy">
                                        <option value="Đứng thẳng">Đứng thẳng</option>
                                        <option value="Ngồi">Ngồi</option>
                                        <option value="Tựa Người Lên Đồ Vật">Tựa Người Lên Đồ Vật</option>
                                    </select>
                                </div>
                                <div>
                                    <label className="block text-xs font-bold text-navy uppercase tracking-wider mb-1.5">5. Phong cách tranh</label>
                                    <select value={selectedArtStyle} onChange={(e) => setSelectedArtStyle(e.target.value)} className="w-full bg-cream/50 border border-gold/30 rounded-xl p-2.5 text-xs font-bold text-navy">
                                        <option value="Chân Thực">Chân Thực</option>
                                        <option value="Hoạt Hình">Hoạt Hình</option>
                                        <option value="Bán Chân Thực">Bán Chân Thực</option>
                                    </select>
                                </div>
                            </div>

                            {/* 6. Setting & Color */}
                            <div className="grid grid-cols-2 gap-3">
                                <div>
                                    <label className="block text-xs font-bold text-navy uppercase tracking-wider mb-1.5">6. Bối cảnh</label>
                                    <select value={selectedSetting} onChange={(e) => setSelectedSetting(e.target.value)} className="w-full bg-cream/50 border border-gold/30 rounded-xl p-2.5 text-xs font-bold text-navy">
                                        <option value="Hoàng thành Thăng Long">Hoàng thành Thăng Long</option>
                                        <option value="Đại Nội Huế">Đại Nội Huế</option>
                                        <option value="Phố Cổ Hội An">Phố Cổ Hội An</option>
                                        <option value="Lễ hội Dân gian Bắc Bộ">Lễ hội Dân gian Bắc Bộ</option>
                                    </select>
                                </div>
                                <div>
                                    <label className="block text-xs font-bold text-navy uppercase tracking-wider mb-1.5">7. Tông màu</label>
                                    <input 
                                        type="text" 
                                        value={customColor}
                                        onChange={(e) => setCustomColor(e.target.value)}
                                        className="w-full bg-cream/50 border border-gold/30 rounded-xl p-2.5 text-xs font-bold text-navy"
                                        placeholder="VD: Đỏ, Vàng, Đen..."
                                    />
                                </div>
                            </div>

                            <button
                                onClick={handleRenderAIOutfit}
                                disabled={isRenderingImage}
                                className="w-full py-3.5 crimson-gradient text-gold rounded-xl font-bold text-sm shadow-lg hover:brightness-110 transition flex items-center justify-center space-x-2 disabled:opacity-50"
                            >
                                <i data-lucide="wand-2" className="w-4 h-4"></i>
                                <span>{isRenderingImage ? `Rendering với ${AI_IMAGE_MODEL_NAME}...` : 'Tạo Ảnh Thử Đồ Ảo AI'}</span>
                            </button>
                        </div>

                        {/* Result Display */}
                        <div className="lg:col-span-6 bg-white rounded-2xl p-6 shadow-sm border border-gold/20 flex flex-col justify-between">
                            <div>
                                <div className="flex justify-between items-center mb-3">
                                    <h3 className="text-xs font-bold text-navy uppercase tracking-wider">Kết Quả Render Trực Tiếp</h3>
                                    {isBackupUsed && (
                                        <span className="text-[10px] bg-amber-100 text-amber-900 font-bold px-2 py-0.5 rounded border border-amber-300">
                                            ⚠️ Backup Plan Trùng Khớp
                                        </span>
                                    )}
                                </div>
                                <div className="min-h-[380px] bg-cream/40 rounded-xl border border-dashed border-gold/40 flex flex-col items-center justify-center p-4 relative overflow-hidden">
                                    {isRenderingImage ? (
                                        <div className="text-center space-y-3">
                                            <div className="w-10 h-10 border-4 border-gold border-t-crimson rounded-full animate-spin mx-auto"></div>
                                            <p className="text-xs font-bold text-crimson animate-pulse-slow">Model AI {AI_IMAGE_MODEL_NAME} đang xử lý...</p>
                                        </div>
                                    ) : aiRenderedImage ? (
                                        <div className="w-full space-y-3 text-center">
                                            <div className="relative group cursor-pointer" onClick={() => onImageClick(aiRenderedImage)}>
                                                <img src={aiRenderedImage} alt="Render Result" className="w-full h-[360px] object-cover rounded-xl shadow-md border border-gold" />
                                                <div className="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition rounded-xl flex items-center justify-center text-white font-bold text-xs gap-1">
                                                    <i data-lucide="maximize-2" className="w-5 h-5"></i> Phóng To & Tải Ảnh
                                                </div>
                                            </div>

                                            {isBackupUsed && (
                                                <div className="bg-amber-50 p-2.5 rounded-lg border border-amber-200 text-left space-y-1">
                                                    <p className="text-[11px] text-amber-900 font-bold">Kế hoạch Backup kích hoạt:</p>
                                                    <p className="text-[10px] text-amber-800 font-mono">Tên File Backup: <span className="font-bold underline">{backupFileName}</span></p>
                                                </div>
                                            )}

                                            <button 
                                                onClick={() => {
                                                    if (!savedLookbook.includes(aiRenderedImage)) {
                                                        setSavedLookbook([...savedLookbook, aiRenderedImage]);
                                                    }
                                                }}
                                                className="bg-teal text-white px-4 py-2 rounded-xl text-xs font-bold shadow hover:bg-navy transition inline-flex items-center space-x-1.5"
                                            >
                                                <i data-lucide="archive" className="w-4 h-4"></i>
                                                <span>Lưu Vào Kho Lưu Trữ ({savedLookbook.length})</span>
                                            </button>
                                        </div>
                                    ) : (
                                        <div className="text-center space-y-2">
                                            <img src={currentObj.bgImage} alt="Preview" className="max-h-56 rounded-xl object-cover border border-gold/30 mx-auto cursor-pointer" onClick={() => onImageClick(currentObj.bgImage)} />
                                            <p className="text-xs text-gray-500 italic mt-2">Bấm nút "Tạo Ảnh Thử Đồ Ảo AI" để xem kết quả.</p>
                                        </div>
                                    )}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            );
        }

        // 3. BẢO TÀNG 3D CẬP NHẬT TRỌN BỘ MODEL V5.0
        function Museum3DView() {
            const [activeModel, setActiveModel] = useState(MUSEUM_MODELS_3D[0]);

            return (
                <div className="max-w-6xl mx-auto space-y-8 animate-fadeIn">
                    <div className="text-center max-w-2xl mx-auto">
                        <span className="text-xs font-semibold text-crimson uppercase tracking-widest">Không Gian Văn Hóa Interactive</span>
                        <h2 className="font-playfair text-3xl sm:text-4xl font-bold text-navy mt-1">Bảo Tàng 3D Cổ Phục</h2>
                        <p className="text-gray-600 text-sm mt-2">
                            Mô hình 3D xoay 360 độ từ Sketchfab & CLO-SET viewer cho từng loại cổ phục truyền thống.
                        </p>
                    </div>

                    <div className="grid grid-cols-2 sm:grid-cols-5 gap-2.5">
                        {MUSEUM_MODELS_3D.map((m) => (
                            <button
                                key={m.id}
                                onClick={() => setActiveModel(m)}
                                className={`p-3 rounded-xl border text-left transition-all ${
                                    activeModel.id === m.id
                                        ? 'bg-navy text-gold border-gold shadow-md font-semibold'
                                        : 'bg-white text-gray-700 border-gray-200 hover:border-gold'
                                }`}
                            >
                                <p className="text-xs font-bold truncate">{m.title}</p>
                                <p className="text-[10px] opacity-75 mt-0.5">{m.era}</p>
                            </button>
                        ))}
                    </div>

                    <div className="bg-white rounded-2xl p-4 sm:p-6 shadow-sm border border-gold/20 space-y-4">
                        <div className="relative w-full h-[480px] sm:h-[550px] rounded-xl overflow-hidden bg-black shadow-inner">
                            <iframe 
                                title={activeModel.title} 
                                src={activeModel.embedUrl}
                                className="w-full h-full border-0"
                                allow="autoplay; fullscreen; vr"
                            ></iframe>
                        </div>

                        <div className="flex justify-between items-start">
                            <div>
                                <h3 className="font-playfair text-xl font-bold text-navy">{activeModel.title}</h3>
                                <p className="text-xs text-gray-600 mt-1">{activeModel.desc}</p>
                            </div>
                            <span className="text-[10px] bg-gold/20 text-navy font-bold px-3 py-1 rounded-full uppercase">
                                Nền tảng: {activeModel.type}
                            </span>
                        </div>
                    </div>
                </div>
            );
        }

        // 4. MINI-GAME VIỆT PHỤC REMIX
        function MinigameRemixView({
            gameTheme, setGameTheme,
            gameOutfit, setGameOutfit,
            activeAccCategoryTab, setActiveAccCategoryTab,
            gameSelectedAccs, toggleRemixAccessory,
            gamePose, setGamePose,
            gameArtStyle, setGameArtStyle,
            handleEvaluateGameOutfit, isEvaluatingGame,
            gameEvalResult, gameRenderedImage, gameEvalError,
            savedLookbook, setSavedLookbook, costumeData, onImageClick
        }) {
            const filteredAccs = GLOBAL_ACCESSORIES.filter(a => a.category === activeAccCategoryTab);

            return (
                <div className="max-w-5xl mx-auto space-y-8 animate-fadeIn">
                    <div className="text-center max-w-2xl mx-auto">
                        <span className="text-xs font-semibold text-crimson uppercase tracking-widest">Sáng Tạo Không Giới Hạn</span>
                        <h2 className="font-playfair text-3xl font-bold text-navy mt-1">Việt Phục Remix v5.0</h2>
                        <p className="text-xs text-gray-600 mt-2">Phối đồ cổ truyền & nhận trọn bộ 3 Danh hiệu Badge khi đạt từ 80 điểm trở lên!</p>
                    </div>

                    {/* Active Theme Card */}
                    <div className="bg-white rounded-2xl p-5 border-2 border-gold/40 shadow-sm flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                        <div>
                            <span className="bg-crimson text-gold text-[10px] font-bold px-2.5 py-0.5 rounded-full uppercase">Chủ Đề Thi Đấu</span>
                            <h3 className="font-playfair text-lg font-bold text-navy mt-1">{gameTheme.title}</h3>
                            <p className="text-xs text-gray-600 mt-0.5">{gameTheme.description}</p>
                        </div>
                        <button 
                            onClick={() => {
                                const nextIndex = (GAME_THEMES.findIndex(t => t.id === gameTheme.id) + 1) % GAME_THEMES.length;
                                setGameTheme(GAME_THEMES[nextIndex]);
                            }}
                            className="text-xs bg-cream text-crimson px-3 py-2 rounded-xl border border-gold/30 font-bold hover:bg-crimson hover:text-gold transition shrink-0"
                        >
                            Đổi Chủ Đề
                        </button>
                    </div>

                    <div className="bg-white p-6 rounded-2xl border border-gold/20 shadow-sm space-y-5">
                        {/* Outfit Selection */}
                        <div>
                            <label className="text-xs font-bold uppercase text-crimson block mb-2">1. Chọn Trang Phục Chính</label>
                            <div className="grid grid-cols-2 sm:grid-cols-3 gap-2">
                                {costumeData.map((item) => (
                                    <button
                                        key={item.id}
                                        onClick={() => setGameOutfit(item)}
                                        className={`p-2.5 rounded-xl border text-left text-xs font-bold transition ${
                                            gameOutfit.id === item.id ? 'bg-crimson text-gold border-gold' : 'bg-cream/50 text-navy border-gray-200'
                                        }`}
                                    >
                                        {item.name}
                                    </button>
                                ))}
                            </div>
                        </div>

                        {/* Classified Accessories Picker */}
                        <div>
                            <div className="flex justify-between items-center mb-2">
                                <label className="text-xs font-bold uppercase text-crimson">
                                    2. Chọn Phụ Kiện Theo Nhóm ({gameSelectedAccs.length} món đã chọn)
                                </label>
                                <span className="text-[10px] text-teal font-semibold">Cultural Guardian Tag Check</span>
                            </div>

                            <div className="flex border-b border-gold/20 space-x-2 overflow-x-auto pb-2 text-xs">
                                {REMIX_ACCESSORY_CATEGORIES.map(cat => (
                                    <button
                                        key={cat.id}
                                        onClick={() => setActiveAccCategoryTab(cat.id)}
                                        className={`px-3 py-1.5 rounded-lg whitespace-nowrap font-bold transition ${
                                            activeAccCategoryTab === cat.id ? 'bg-navy text-gold' : 'bg-cream/60 text-navy hover:bg-gold/20'
                                        }`}
                                    >
                                        {cat.title}
                                    </button>
                                ))}
                            </div>

                            <div className="grid grid-cols-2 sm:grid-cols-3 gap-2 mt-3 p-2 bg-cream/30 rounded-xl border border-gold/20">
                                {filteredAccs.map((acc) => {
                                    const isSelected = gameSelectedAccs.includes(acc.name);
                                    const matchesOutfitTag = acc.tags.includes(gameOutfit.id);

                                    return (
                                        <button
                                            key={acc.id}
                                            onClick={() => toggleRemixAccessory(acc)}
                                            className={`p-2.5 rounded-xl text-xs font-bold border text-left transition flex flex-col justify-between ${
                                                isSelected ? 'bg-gold text-navy border-gold shadow-sm' : 'bg-white text-navy border-gray-200 hover:border-gold'
                                            }`}
                                        >
                                            <div className="flex justify-between items-start">
                                                <span className="truncate">{acc.name}</span>
                                                {matchesOutfitTag && (
                                                    <span className="text-[9px] bg-emerald-100 text-emerald-800 px-1.5 py-0.5 rounded font-bold ml-1">
                                                        Chuẩn
                                                    </span>
                                                )}
                                            </div>
                                            <span className="text-[9px] opacity-70 mt-1">Tag: [{acc.tags.join(', ')}]</span>
                                        </button>
                                    );
                                })}
                            </div>
                        </div>

                        {/* Pose & Style */}
                        <div className="grid grid-cols-2 gap-3">
                            <div>
                                <label className="text-xs font-bold uppercase text-crimson block mb-1">3. Tư thế Pose</label>
                                <select value={gamePose} onChange={(e) => setGamePose(e.target.value)} className="w-full bg-cream/50 text-xs font-bold p-2.5 rounded-xl border border-gold/30">
                                    <option value="Đứng thẳng">Đứng thẳng</option>
                                    <option value="Ngồi">Ngồi</option>
                                    <option value="Tựa Người Lên Đồ Vật">Tựa Người Lên Đồ Vật</option>
                                </select>
                            </div>
                            <div>
                                <label className="text-xs font-bold uppercase text-crimson block mb-1">4. Phong cách tranh</label>
                                <select value={gameArtStyle} onChange={(e) => setGameArtStyle(e.target.value)} className="w-full bg-cream/50 text-xs font-bold p-2.5 rounded-xl border border-gold/30">
                                    <option value="Chân Thực">Chân Thực</option>
                                    <option value="Hoạt Hình">Hoạt Hình</option>
                                    <option value="Bán Chân Thực">Bán Chân Thực</option>
                                </select>
                            </div>
                        </div>

                        <button
                            onClick={handleEvaluateGameOutfit}
                            disabled={isEvaluatingGame}
                            className="w-full crimson-gradient text-gold py-3.5 rounded-xl font-bold text-xs shadow-md hover:brightness-110 transition flex items-center justify-center space-x-2 disabled:opacity-50"
                        >
                            <i data-lucide="award" className="w-4 h-4"></i>
                            <span>{isEvaluatingGame ? 'Giám Khảo AI Đang Chấm Điểm...' : 'Gửi Bài & Chấm Điểm AI Chuyên Gia'}</span>
                        </button>

                        {gameEvalError && <p className="text-xs text-vermilion text-center bg-red-50 p-2.5 rounded-xl">{gameEvalError}</p>}

                        {/* Evaluation Score Display */}
                        {gameEvalResult && (
                            <div className="bg-navy text-cream p-5 rounded-2xl border-2 border-gold space-y-4 shadow-xl">
                                <div className="flex items-center justify-between border-b border-gold/30 pb-3">
                                    <h4 className="font-playfair font-bold text-base text-gold flex items-center gap-2">
                                        <i data-lucide="award" className="w-5 h-5 text-gold"></i>
                                        <span>Kết Quả Đánh Giá Giám Khảo Gemini AI</span>
                                    </h4>
                                    <span className="text-[10px] bg-crimson text-gold px-2.5 py-0.5 rounded-full font-bold">ViNO v5.0</span>
                                </div>

                                <div className="grid grid-cols-3 gap-2 text-center">
                                    <div className={`p-3 rounded-xl border ${gameEvalResult.fitScore >= 80 ? 'bg-emerald-950/80 border-emerald-400 text-emerald-200' : 'bg-gray-800/80 border-gold/20 text-gray-200'}`}>
                                        <span className="text-[10px] block font-semibold">Phù Hợp</span>
                                        <span className="font-playfair text-lg font-bold text-gold">{gameEvalResult.fitScore}/100</span>
                                        {gameEvalResult.fitScore >= 80 && <span className="text-[8px] bg-emerald-500 text-white font-bold px-1 rounded block mt-1">🏆 Awarded</span>}
                                    </div>
                                    <div className={`p-3 rounded-xl border ${gameEvalResult.creativeScore >= 80 ? 'bg-purple-950/80 border-purple-400 text-purple-200' : 'bg-gray-800/80 border-gold/20 text-gray-200'}`}>
                                        <span className="text-[10px] block font-semibold">Sáng Tạo</span>
                                        <span className="font-playfair text-lg font-bold text-gold">{gameEvalResult.creativeScore}/100</span>
                                        {gameEvalResult.creativeScore >= 80 && <span className="text-[8px] bg-purple-500 text-white font-bold px-1 rounded block mt-1">🏆 Awarded</span>}
                                    </div>
                                    <div className={`p-3 rounded-xl border ${gameEvalResult.diversityScore >= 80 ? 'bg-amber-950/80 border-amber-400 text-amber-200' : 'bg-gray-800/80 border-gold/20 text-gray-200'}`}>
                                        <span className="text-[10px] block font-semibold">Đa Dạng</span>
                                        <span className="font-playfair text-lg font-bold text-gold">{gameEvalResult.diversityScore}/100</span>
                                        {gameEvalResult.diversityScore >= 80 && <span className="text-[8px] bg-amber-500 text-white font-bold px-1 rounded block mt-1">🏆 Awarded</span>}
                                    </div>
                                </div>

                                <div className="bg-gray-800/90 p-3.5 rounded-xl border border-gold/20 space-y-1 text-xs">
                                    <span className="font-bold text-emerald-400 uppercase">Nhận Xét Chi Tiết:</span>
                                    <p className="text-gray-200 leading-relaxed">{gameEvalResult.feedback}</p>
                                </div>

                                {gameRenderedImage && (
                                    <div className="pt-2 text-center space-y-2">
                                        <span className="text-xs font-bold text-gold block">Tác Phẩm Render Bởi AI (Bấm vào ảnh để phóng to):</span>
                                        <img 
                                            src={gameRenderedImage} 
                                            alt="Rendered Remix" 
                                            onClick={() => onImageClick(gameRenderedImage)}
                                            className="max-w-xs mx-auto rounded-xl border-2 border-gold shadow-lg cursor-pointer hover:scale-105 transition duration-300" 
                                        />
                                        <button 
                                            onClick={() => {
                                                if (!savedLookbook.includes(gameRenderedImage)) {
                                                    setSavedLookbook([...savedLookbook, gameRenderedImage]);
                                                }
                                            }}
                                            className="bg-gold text-navy px-4 py-2 rounded-xl text-xs font-bold shadow hover:bg-white transition inline-flex items-center space-x-1.5"
                                        >
                                            <i data-lucide="archive" className="w-4 h-4"></i>
                                            <span>Lưu Tác Phẩm Vào Kho</span>
                                        </button>
                                    </div>
                                )}
                            </div>
                        )}
                    </div>
                </div>
            );
        }

        // 5. KIỂM TRA LỊCH SỬ (10 CÂU HỎI TRẮC NGHIỆM CHUẨN)
        function QuizView({ unlockBadge, onGoToStorage }) {
            const [currentQIndex, setCurrentQIndex] = useState(0);
            const [selectedAnswers, setSelectedAnswers] = useState(Array(QUIZ_QUESTIONS.length).fill(null));
            const [showExplanation, setShowExplanation] = useState(false);
            const [isFinished, setIsFinished] = useState(false);
            const [finalScore, setFinalScore] = useState(0);

            const q = QUIZ_QUESTIONS[currentQIndex];

            const handleSelectOption = (optIndex) => {
                if (showExplanation) return;
                const updated = [...selectedAnswers];
                updated[currentQIndex] = optIndex;
                setSelectedAnswers(updated);
                setShowExplanation(true);
            };

            const handleNext = () => {
                setShowExplanation(false);
                if (currentQIndex + 1 >= QUIZ_QUESTIONS.length) {
                    // TÍNH ĐIỂM CHUẨN CẢ 10 CÂU (MỖI CÂU 10 ĐIỂM)
                    let total = 0;
                    selectedAnswers.forEach((ans, idx) => {
                        if (ans === QUIZ_QUESTIONS[idx].correct) total += 10;
                    });
                    setFinalScore(total);
                    setIsFinished(true);

                    if (total >= 80) {
                        unlockBadge({
                            id: 'su-gia-van-hoa',
                            title: 'Sứ Giả Văn Hóa',
                            icon: 'award',
                            colorTheme: 'bg-gradient-to-r from-red-700 to-amber-800 text-gold border-gold',
                            desc: 'Hoàn thành xuất sắc bộ 10 câu hỏi Kiểm Tra Lịch Sử Cổ Phục với điểm số >= 80/100!'
                        });
                    }
                } else {
                    setCurrentQIndex(currentQIndex + 1);
                }
            };

            const handleResetQuiz = () => {
                setCurrentQIndex(0);
                setSelectedAnswers(Array(QUIZ_QUESTIONS.length).fill(null));
                setShowExplanation(false);
                setIsFinished(false);
                setFinalScore(0);
            };

            return (
                <div className="max-w-3xl mx-auto space-y-8 animate-fadeIn">
                    <div className="text-center max-w-xl mx-auto">
                        <span className="text-xs font-semibold text-crimson uppercase tracking-widest">Thử Thách Tri Thức v5.0</span>
                        <h2 className="font-playfair text-3xl sm:text-4xl font-bold text-navy mt-1">Kiểm Tra Lịch Sử Cổ Phục</h2>
                        <p className="text-xs text-gray-600 mt-2">Trọn bộ 10 câu hỏi kiến thức di sản (Dễ - Trung Bình - Khó)</p>
                    </div>

                    {!isFinished ? (
                        <div className="bg-white rounded-2xl p-6 sm:p-8 shadow-sm border border-gold/20 space-y-6">
                            <div className="flex justify-between items-center text-xs font-bold text-gray-500 border-b border-cream pb-3">
                                <span className="bg-gold/20 text-navy px-2.5 py-0.5 rounded-full uppercase">
                                    Mức độ: {q.level}
                                </span>
                                <span className="text-crimson">Câu {currentQIndex + 1} / {QUIZ_QUESTIONS.length}</span>
                            </div>

                            <h3 className="font-playfair text-lg font-bold text-navy leading-snug">{q.question}</h3>
                            
                            <div className="space-y-3">
				{q.options.map((opt, idx) => {
                                    const isSelected = selectedAnswers[currentQIndex] === idx;
                                    const isCorrect = idx === q.correct;
                                    let btnStyle = "bg-cream/60 border-gray-200 text-navy hover:border-gold";

                                    if (showExplanation) {
                                        if (isCorrect) btnStyle = "bg-emerald-100 border-emerald-500 text-emerald-900 font-bold";
                                        else if (isSelected) btnStyle = "bg-red-100 border-red-500 text-red-900 font-bold";
                                    } else if (isSelected) {
                                        btnStyle = "bg-gold text-navy border-gold font-bold shadow-sm";
                                    }

                                    return (
                                        <button
                                            key={idx}
                                            onClick={() => handleSelectOption(idx)}
                                            className={`w-full text-left p-4 rounded-xl border text-xs sm:text-sm font-medium transition-all duration-200 flex items-center justify-between ${btnStyle}`}
                                        >
                                            <span>{opt}</span>
                                            {showExplanation && isCorrect && (
                                                <i data-lucide="check-circle" className="w-5 h-5 text-emerald-600 shrink-0 ml-2"></i>
                                            )}
                                            {showExplanation && isSelected && !isCorrect && (
                                                <i data-lucide="x-circle" className="w-5 h-5 text-red-600 shrink-0 ml-2"></i>
                                            )}
                                        </button>
                                    );
                                })}
                            </div>

                            {/* Explanation Box */}
                            {showExplanation && (
                                <div className="bg-cream p-4 sm:p-5 rounded-2xl border border-gold/30 space-y-3 text-xs animate-fadeIn">
                                    <div className="flex items-center space-x-2 text-crimson font-bold uppercase tracking-wider">
                                        <i data-lucide="lightbulb" className="w-4 h-4 text-gold"></i>
                                        <span>Giải Thích Kiến Thức Cổ Phục:</span>
                                    </div>
                                    <p className="text-gray-700 leading-relaxed bg-white/70 p-3 rounded-xl border border-gold/20">
                                        {q.explanation}
                                    </p>
                                    <div className="flex justify-end pt-2">
                                        <button
                                            onClick={handleNext}
                                            className="bg-crimson text-gold px-6 py-2.5 rounded-xl font-bold text-xs shadow-md hover:bg-vermilion transition flex items-center space-x-2"
                                        >
                                            <span>{currentQIndex + 1 >= QUIZ_QUESTIONS.length ? 'Xem Kết Quả Trắc Nghiệm' : 'Câu Hỏi Tiếp Theo'}</span>
                                            <i data-lucide="arrow-right" className="w-4 h-4"></i>
                                        </button>
                                    </div>
                                </div>
                            )}
                        </div>
                    ) : (
                        /* Result Screen */
                        <div className="bg-white rounded-2xl p-8 shadow-md border-2 border-gold text-center space-y-6 animate-pop">
                            <div className="w-20 h-20 mx-auto rounded-full crimson-gradient border-2 border-gold flex items-center justify-center text-gold shadow-xl">
                                <i data-lucide="trophy" className="w-10 h-10"></i>
                            </div>

                            <div>
                                <span className="text-xs font-bold uppercase tracking-widest text-teal bg-teal/10 px-3 py-1 rounded-full">
                                    Kết Quả Kiểm Tra Lịch Sử (10 Câu)
                                </span>
                                <h3 className="font-playfair text-3xl font-bold text-navy mt-2">Tổng Điểm Của Bạn</h3>
                                <p className="text-5xl font-extrabold text-crimson mt-2 font-playfair">{finalScore} / 100</p>
                            </div>

                            {finalScore >= 80 ? (
                                <div className="bg-emerald-50 border border-emerald-300 p-4 rounded-2xl text-emerald-900 text-xs sm:text-sm space-y-1">
                                    <p className="font-bold text-base">🎉 Chúc mừng! Bạn đã đạt danh hiệu "Sứ Giả Văn Hóa"!</p>
                                    <p className="text-emerald-800">Badge cùng mốc thời gian đã được tự động mở khóa và lưu vào Kho Lưu Trữ của bạn.</p>
                                </div>
                            ) : (
                                <div className="bg-amber-50 border border-amber-300 p-4 rounded-2xl text-amber-900 text-xs sm:text-sm space-y-1">
                                    <p className="font-bold">Bạn đã hoàn thành bài thi với {finalScore}/100 điểm.</p>
                                    <p className="text-amber-800">Cần đạt từ 80 điểm trở lên để nhận Badge "Sứ Giả Văn Hóa". Hãy thử lại nhé!</p>
                                </div>
                            )}

                            <div className="flex flex-col sm:flex-row justify-center gap-3 pt-2">
                                <button
                                    onClick={handleResetQuiz}
                                    className="bg-cream text-navy border border-gold/40 px-6 py-3 rounded-xl font-bold text-xs hover:bg-gold/20 transition flex items-center justify-center space-x-2"
                                >
                                    <i data-lucide="rotate-ccw" className="w-4 h-4"></i>
                                    <span>Làm Lại Bài Kiểm Tra</span>
                                </button>
                                <button
                                    onClick={onGoToStorage}
                                    className="bg-navy text-gold px-6 py-3 rounded-xl font-bold text-xs shadow-md hover:bg-crimson transition flex items-center justify-center space-x-2"
                                >
                                    <i data-lucide="archive" className="w-4 h-4"></i>
                                    <span>Xem Trong Kho Lưu Trữ</span>
                                </button>
                            </div>
                        </div>
                    )}
                </div>
            );
        }

        // 6. CỬA HÀNG TIỆM MAY CỔ PHỤC
        function ShopsView() {
            return (
                <div className="max-w-5xl mx-auto space-y-8 animate-fadeIn">
                    <div className="text-center max-w-2xl mx-auto">
                        <span className="text-xs font-semibold text-crimson uppercase tracking-widest">Địa Chỉ Uy Tín</span>
                        <h2 className="font-playfair text-3xl font-bold text-navy mt-1">Cửa Hàng Tiệm May Cổ Phục</h2>
                        <p className="text-xs text-gray-600 mt-2">Danh sách tiệm may và studio cho thuê cổ phục uy tín tại Hà Nội & TP.HCM</p>
                    </div>

                    <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                        {TAILOR_SHOPS.map((shop) => (
                            <div key={shop.id} className="bg-white rounded-2xl p-6 shadow-sm border border-gold/20 space-y-4 hover:border-gold transition">
                                <div className="flex justify-between items-start">
                                    <div>
                                        <span className="text-[10px] bg-gold/20 text-navy font-bold px-2.5 py-0.5 rounded-full uppercase">
                                            {shop.location}
                                        </span>
                                        <h3 className="font-playfair text-xl font-bold text-navy mt-2">{shop.name}</h3>
                                    </div>
                                    <div className="flex items-center space-x-1 text-amber-500 font-bold text-xs bg-amber-50 px-2 py-1 rounded-lg">
                                        <i data-lucide="star" className="w-3.5 h-3.5 fill-amber-500"></i>
                                        <span>{shop.rating}</span>
                                    </div>
                                </div>

                                <div className="space-y-2 text-xs text-gray-700 bg-cream/40 p-4 rounded-xl border border-gold/10">
                                    <p className="flex items-center space-x-2">
                                        <i data-lucide="map-pin" className="w-4 h-4 text-crimson shrink-0"></i>
                                        <span><strong>Địa chỉ:</strong> {shop.address}</span>
                                    </p>
                                    <p className="flex items-center space-x-2">
                                        <i data-lucide="phone" className="w-4 h-4 text-teal shrink-0"></i>
                                        <span><strong>Điện thoại:</strong> {shop.phone}</span>
                                    </p>
                                    <p className="flex items-center space-x-2">
                                        <i data-lucide="scissors" className="w-4 h-4 text-gold shrink-0"></i>
                                        <span><strong>Chuyên:</strong> {shop.specialty}</span>
                                    </p>
                                    <p className="flex items-center space-x-2 text-crimson font-bold">
                                        <i data-lucide="tag" className="w-4 h-4 shrink-0"></i>
                                        <span><strong>Khoảng giá:</strong> {shop.priceRange}</span>
                                    </p>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            );
        }

        // 7. KHO LƯU TRỮ & BADGES DANH HIỆU
        function StorageView({ savedLookbook, userBadges, onImageClick }) {
            return (
                <div className="max-w-6xl mx-auto space-y-8 animate-fadeIn">
                    <div className="text-center max-w-2xl mx-auto">
                        <span className="text-xs font-semibold text-crimson uppercase tracking-widest">Bộ Sưu Tập Cá Nhân</span>
                        <h2 className="font-playfair text-3xl font-bold text-navy mt-1">Kho Lưu Trữ Di Sản</h2>
                        <p className="text-xs text-gray-600 mt-2">Nơi lưu giữ các Badge danh hiệu đạt được và Lookbook tác phẩm của riêng bạn!</p>
                    </div>

                    {/* Badge Collection Section */}
                    <div className="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-gold/20 space-y-6">
                        <div className="flex justify-between items-center border-b border-cream pb-4">
                            <h3 className="font-playfair text-xl font-bold text-navy flex items-center space-x-2">
                                <i data-lucide="award" className="w-6 h-6 text-gold"></i>
                                <span>Hệ Thống Badge Danh Hiệu ({userBadges.length})</span>
                            </h3>
                            <span className="text-xs font-semibold text-teal bg-teal/10 px-3 py-1 rounded-full">
                                Đã Mở Khóa: {userBadges.length} Badge
                            </span>
                        </div>

                        <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                            {userBadges.map((badge) => (
                                <div 
                                    key={badge.id}
                                    className="p-4 rounded-2xl bg-cream/60 border border-gold/30 flex items-center space-x-4 shadow-sm hover:border-gold transition"
                                >
                                    <div className={`w-14 h-14 rounded-2xl ${badge.colorTheme || 'bg-gradient-to-r from-amber-600 to-red-800 text-gold'} border border-gold/40 flex items-center justify-center shrink-0 shadow-md`}>
                                        <i data-lucide={badge.icon || 'award'} className="w-7 h-7"></i>
                                    </div>
                                    <div className="space-y-1">
                                        <h4 className="font-bold text-xs text-navy">{badge.title}</h4>
                                        <p className="text-[10px] text-gray-600 leading-tight">{badge.desc}</p>
                                        <span className="text-[9px] text-teal font-semibold block pt-1">
                                            Thời điểm: {badge.date}
                                        </span>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>

                    {/* Saved Lookbook Gallery */}
                    <div className="bg-white p-6 sm:p-8 rounded-2xl shadow-sm border border-gold/20 space-y-6">
                        <div className="flex justify-between items-center border-b border-cream pb-4">
                            <h3 className="font-playfair text-xl font-bold text-navy flex items-center space-x-2">
                                <i data-lucide="image" className="w-6 h-6 text-gold"></i>
                                <span>Lookbook Tác Phẩm Đã Lưu ({savedLookbook.length})</span>
                            </h3>
                            <span className="text-xs text-gray-500 italic">(Bấm vào hình để phóng to & tải về)</span>
                        </div>

                        {savedLookbook.length > 0 ? (
                            <div className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
                                {savedLookbook.map((imgUrl, idx) => (
                                    <div 
                                        key={idx} 
                                        onClick={() => onImageClick(imgUrl)}
                                        className="relative rounded-2xl overflow-hidden border border-gold/30 shadow-md h-52 bg-cream cursor-pointer group"
                                    >
                                        <img src={imgUrl} alt={`Saved ${idx}`} className="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
                                        <div className="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition flex items-center justify-center text-white text-xs font-bold gap-1">
                                            <i data-lucide="maximize-2" className="w-4 h-4"></i> Phóng To
                                        </div>
                                    </div>
                                ))}
                            </div>
                        ) : (
                            <div className="text-center py-12 bg-cream/30 rounded-2xl border border-dashed border-gold/30 space-y-2">
                                <i data-lucide="archive" className="w-10 h-10 text-gray-400 mx-auto"></i>
                                <p className="text-xs text-gray-500 italic">Chưa có tác phẩm nào được lưu vào Lookbook.</p>
                                <p className="text-[11px] text-teal">Hãy thử đồ AI hoặc tham gia Remix để lưu lại hình ảnh đẹp nhé!</p>
                            </div>
                        )}
                    </div>
                </div>
            );
        }

        // Render React Application
        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
